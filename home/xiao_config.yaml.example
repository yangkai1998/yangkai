# 居家推荐路径：基于开源 xiaogpt 的本地桥接
# 复制为 xiao_config.yaml 后填写，再按 docs/02-home-path-windows.md 启动
#
# 重要：真正的 API Key / 密码 / Cookie 只写进 xiao_config.yaml（已被 gitignore）
# 不要写进本 example 文件，也不要提交到 GitHub

# 音箱型号（看音箱底部贴纸，或 micli mina）
hardware: LX06

# 小米账号：优先用「小米 ID」数字，不要只用手机号
account: "你的小米ID数字"
password: "你的密码"
# cookie: "从 mina 相关接口抓到的 Cookie（可选，风控时用）"
mi_did: "音箱DID"

# DeepSeek
bot: chatgptapi
openai_key: "sk-在这里粘贴你的完整密钥"
api_base: "https://api.deepseek.com/v1"

gpt_options:
  model: "deepseek-v4-flash"
  temperature: 0.7

# 只有这些开头的话才会交给大模型
keyword:
  - "问助手"
  - "问杨凯"
  - "帮我问"

prompt: "你是居家小爱音箱上的智能助手，用简洁中文回答，尽量 80 字以内，不要 Markdown。"
mute_xiaoai: true
stream: true
verbose: true
use_command: false

# 持续对话（可选）
start_conversation: "开始持续对话"
end_conversation: "结束持续对话"
