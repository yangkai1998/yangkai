# ===== LLM（OpenAI 兼容接口，必填）=====
# 国内可用：DeepSeek / 通义 / Moonshot / 智谱 等兼容网关
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.7

# ===== 口令触发（路径 B）=====
TRIGGER_KEYWORDS=问助手,问杨凯,帮我问
STRIP_KEYWORDS=true

# ===== 技能鉴权（建议开启）=====
# 填了之后，小爱平台 webhook URL 写成：
# https://你的域名/xiaoai/skill?token=这里的值
SKILL_SHARED_TOKEN=please-change-me

# ===== 会话记忆 =====
ENABLE_SESSION_MEMORY=true
MAX_HISTORY_TURNS=4

# ===== 服务 =====
HOST=0.0.0.0
PORT=8080
APP_NAME=yangkai-xiaoai-bridge
