# ===== LLM（DeepSeek，已验证）=====
# 真正密钥只写 backend/.env（已被 gitignore），不要写进本文件
LLM_API_KEY=sk-在这里粘贴你的完整密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=8
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.7

# ===== 口令触发 =====
TRIGGER_KEYWORDS=问助手,问杨凯,帮我问
STRIP_KEYWORDS=true

# ===== 技能鉴权（建议开启）=====
# https://你的域名/xiaoai/skill?token=这里的值
SKILL_SHARED_TOKEN=please-change-me

# ===== 会话记忆 =====
ENABLE_SESSION_MEMORY=true
MAX_HISTORY_TURNS=4

# ===== 服务 =====
HOST=0.0.0.0
PORT=8080
APP_NAME=yangkai-xiaoai-bridge
